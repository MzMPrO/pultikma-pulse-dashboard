# Copy to backend/.env (or export). Never commit real keys.
# PostGIS (optional; without it the backend serves the same results from data/*.csv in memory)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
# Any OpenAI-compatible provider (all three needed; otherwise the scripted chat fallback is used)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional overrides
# DATA_DIR=./data
# FX_OFFLINE=1   # skip the CBU rate request, use 12800
