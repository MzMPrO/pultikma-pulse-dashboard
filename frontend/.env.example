# Copy to frontend/.env (git-ignored). Values are baked into the bundle at build time (VITE_*),
# so they end up in the browser: only put PUBLIC keys here (map tiles / browser Maps key), never secrets.

# Backend API base URL. Local dev: http://localhost:8000. Production: https://<your-domain> (nginx proxies /api/ to the backend).
VITE_API_URL=http://localhost:8000

# Map tiles for /app and the landing hero (MapTiler). Pattern WITHOUT a key:
#   https://api.maptiler.com/maps/dataviz-dark/256/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY
# If empty, falls back to CARTO Dark Matter (no key needed).
VITE_TILE_URL=https://api.maptiler.com/maps/dataviz-dark/256/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY
VITE_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# Optional: decorative Google Map on the landing (SVG fallback when the key is empty).
# Names keep the legacy "LOVABLE_CONNECTOR" prefix because the code reads them; they are plain Google keys.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
