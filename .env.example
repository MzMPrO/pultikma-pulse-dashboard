# Copy to .env next to docker-compose.yml (git-ignored). Never commit real keys.
# Only docker-compose variables live here:
#   frontend  -> frontend/.env  (see frontend/.env.example)
#   backend (outside docker) -> backend/.env  (see backend/.env.example)

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# Any OpenAI-compatible LLM provider. All three must be set, otherwise the scripted chat fallback is used.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Frontend container (docker compose): API URL baked into the bundle at build time
# (what the BROWSER must call: http://localhost:8000 locally, https://your-domain in prod).
# VITE_API_URL=http://localhost:8000
