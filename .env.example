# Copy to .env (git-ignored). Never commit real keys.

# --- frontend (Vite) ---
VITE_API_URL=http://localhost:8000

# --- backend / docker compose ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
# Used by scripts/load_data.py from the host (compose sets its own URL for the backend container)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse

# Any OpenAI-compatible LLM provider. All three must be set, otherwise the scripted chat fallback is used.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
